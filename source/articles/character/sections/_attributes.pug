+div({name:'attributes header'}).attributes-header
    label(class='header-label') Might
    label(class='header-label') Toughness
    label(class='header-label') Agility
    label(class='header-label') Willpower
    label(class='header-label') Intelligence
    label(class='header-label') Fate
    +input({name:'might', type:'number', value:'0',min: '1', max: '5',trigger:{affects:['mightbonus']}}).attribute-points
    +hidden({name:'mightbonus', type:'number', value:'0', trigger:{formula:'@{might}'}}).attribute-points
    +input({name:'toughness', type:'number', value:'0',min: '1', max: '5',trigger:{affects:['toughnessbonus']}}).attribute-points
    +hidden({name:'toughnessbonus', type:'number', value:'0', trigger:{formula:'@{toughness}'}}).attribute-points
    +input({name:'agility', type:'number', value:'0',min: '1', max: '5',trigger:{affects:['agilitybonus']}}).attribute-points
    +hidden({name:'agilitybonus', type:'number', value:'0', trigger:{formula:'@{agility}'}}).attribute-points
    +input({name:'willpower', type:'number', value:'0',min: '1', max: '5',trigger:{affects:['willpowerbonus']}}).attribute-points
    +hidden({name:'willpowerbonus', type:'number', value:'0', trigger:{formula:'@{willpower}'}}).attribute-points
    +input({name:'intelligence', type:'number', value:'0',min: '1', max: '5',trigger:{affects:['intelligencebonus']}}).attribute-points
    +hidden({name:'intelligencebonus', type:'number', value:'0', trigger:{formula:'@{intelligence}'}}).attribute-points
    +input({name:'fate', type:'number', value:'0',min: '1', max: '5',trigger:{affects:['fatebonus']}}).attribute-points
    +hidden({name:'fatebonus', type:'number', value:'0', trigger:{formula:'@{fate}'}}).attribute-points
+div({name:'other attributes'}).other-attributes
    +div({name:'initiative grid'}).initiative-grid
        label(class='header-label') Initiative
        +button({name: 'initiative roll', value: '&{template:custom} {{name= @{character_name} | Initiative Roll}} {{result=[[(@{leadership_total}+?{Dice Modifier|0})d6!6>?{Dice Colour|White,4|Red,3|Black,2}&{tracker}]]}} {{colour=[[1+?{Dice Colour|White,4|Red,3|Black,2}]]}}'}).roll-button
    label(class='header-label') Oaths
    +adaptiveTextarea({name:'oaths', placeholder:'Enter Oaths here...'  })
    label(class='header-label') Armor Proficiencies
    +adaptiveTextarea({name:'armorprof', placeholder:'Enter armor proficiencies here...'  })
    label(class='header-label') Weapon Proficiencies
    +adaptiveTextarea({name:'weaponprof', placeholder:'Enter weapon proficiencies here...'  })
    label(class='header-label') Class Traits
    +adaptiveTextarea({name:'classtraits', placeholder:'Enter class traits here...'  })
    label(class='header-label') Special Traits
    +adaptiveTextarea({name:'specialtraits', placeholder:'Enter special traits here...'  })
    +div({name:'armor header'}).armor-header
        label(class='header-label') Armor
        label(class='header-label') AV
        label(class='header-label') Penalty
        label(class='header-label') Traits
        +input({name:'armor name', type:'text', placeholder:'Armor Name'}).armor-input
        +input({name:'armor av', type:'number', value:'0', min:'0'}).armor-input
        +input({name:'armor penalty', type:'number', value:'0', min:'0'}).armor-input
        +input({name:'armor traits', type:'text', placeholder:'Armor Traits'}).armor-input
    +div({name:'armor roll'}).armor-roll
        label(class='header-label') Armor Roll 
        +button({name: 'armor roll', value: '&{template:custom} {{name= @{character_name} | Armor Roll}} {{result=[[(@{armor_av}+?{Dice Modifier|0})d6!6>?{Dice Colour|White,4|Red,3|Black,2}]]}} {{colour=[[1+?{Dice Colour|White,4|Red,3|Black,2}]]}}'}).roll-button
