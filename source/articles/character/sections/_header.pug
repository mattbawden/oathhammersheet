+input-label({inputObj:{name:'character name', type:'text'},spanObj:{'data-i18n':'Character Name'}})
+input-label({inputObj:{name:'experience', type:'number'},spanObj:{'data-i18n':'Experience'}})
+div({name:'character-header'}).character-header
    +select-label({inputObj:{name:'lineage'},spanObj:{'data-i18n':'Lineage'}})
        +option({value:''})
            |Select One
        +option({value:'human'})
            |Human
        +option({value:'dwarf'})
            |Dwarf
        +option({value:'highelf'})
            |High Elf
        +option({value:'halfling'})
            |Halfling
        +option({value:'firbolg'})
            |Firbolg
        +option({value:'woodelf'})
            |Wood Elf
    +select-label({inputObj:{name:'class'},spanObj:{'data-i18n':'Class'}})
        +option({value:''})
            |Select One
        +option({value:'berserker'})
            |Berserker
        +option({value:'champion'})
            |Champion
        +option({value:'delver'})
            |Delver
        +option({value:'knight'})
            |Knight
        +option({value:'mage'})
            |Mage
        +option({value:'priest'})
            |Priest
        +option({value:'scout'})
            |Scout
        +option({value:'soldier'})
            |Soldier
        +option({value:'spellblade'})
            |Spellblade
        +option({value:'troubador'})
            |Troubador
    +input-label({inputObj:{name:'grit', type:'number'},spanObj:{'data-i18n':'Grit Points'}})
    +input-label({inputObj:{name:'luck', type:'number'},spanObj:{'data-i18n':'Luck Points'}})
    +input-label({inputObj:{name:'gritcurr', type:'number'},spanObj:{'data-i18n':'Current Grit'}})
    +input-label({inputObj:{name:'luckcurr', type:'number'},spanObj:{'data-i18n':'Current Luck'}})
    +div({name:'dice rollers'}).roller-block
        +div({name:'initiative grid'}).initiative-grid
            label(class='header-label') Initiative
            +button({name: 'initiative roll', value: '&{template:custom} {{name= @{character_name} | Initiative Roll}} {{result=[[(@{leadership_total}+?{Dice Modifier|0})d6!?{Explode Threshold|Normal,6|Special,5}>?{Dice Colour|White,4|Red,3|Black,2}cs>?{Explode Threshold|Normal,6|Special,5}&{tracker}]]}} {{colour=[[1+?{Dice Colour|White,4|Red,3|Black,2}]]}}'}).roll-button
        +div({name:'armor roll'}).armor-roll
            label(class='header-label') Armor Roll 
            +button({name: 'armor roll', value: '&{template:custom} {{name= @{character_name} | Armor Roll}} {{result=[[(@{armor_av}+?{Dice Modifier|0})d6!?{Explode Threshold|Normal,6|Special,5}>?{Dice Colour|White,4|Red,3|Black,2}cs>?{Explode Threshold|Normal,6|Special,5}]]}} {{colour=[[1+?{Dice Colour|White,4|Red,3|Black,2}]]}}'}).roll-button
        +div({name:'general roll'}).general-roll
            label(class='header-label') Dice Roll 
            +button({name: 'general roll', value: '&{template:custom} {{name= @{character_name} | General Roll}} {{result=[[(?{Number of d6|1}+?{Dice Modifier|0})d6!?{Explode Threshold|Normal,6|Special,5}>?{Dice Colour|White,4|Red,3|Black,2}cs>?{Explode Threshold|Normal,6|Special,5}]]}} {{colour=[[1+?{Dice Colour|White,4|Red,3|Black,2}]]}}'}).roll-button